<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin/">Home</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">Kicks</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/user/all">Members</a>
        </li>
        <li class="nav-item" style="cursor: pointer" onclick="showLogoutPopup()">
          <a class="nav-link" style="color: #ffffff; font-weight: bold;">Exit</a>
        </li>
        
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
          function showLogoutPopup() {
            Swal.fire({
              title: "Are you sure?",
              text: "Do you really want to logout?",
              icon: "warning",
              showCancelButton: true,
              confirmButtonColor: "#3085d6",
              cancelButtonColor: "#d33",
              confirmButtonText: "Yes, logout!",
            }).then((result) => {
              if (result.isConfirmed) {
                window.location.href = "/admin/logout";
              }
            });
          }
        </script>
      </ul>
    </div>

    <div class="store-menu-frame">
      <div class="board">
        <div class="products-table">
          <h2 class="new-prod-txt" style="margin-bottom: 30px;">
            STORE MENU
          </h2>
          <table class="table table-bordered table-hover">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">#</th>
                <th scope="col">Product Name</th>
                <th scope="col">Brand</th>
                <th scope="col">Size</th>
                <th scope="col">Price</th>
                <th scope="col">Stock</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <!--  LOOP PRODUCTS: START  -->
              <% products.map((value, key) => { %>
                <tbody style="background: white">
                  <td><%= key + 1 %></td>
                  <td><%= value.productName %></td>
                  <td><%= value.productCollection %></td>
                  <td><%= value.productFilter === ["MEN"] ?
                    value.productFilter : value.productSize %></td>
                    <td><%= value.productPrice %></td>
                    <td><%= value.productLeftCount %></td>
                  <td>
                    <select class="spec-select new-product-status" id="<%= value._id %>">
                      <option value="HOLD" <%= value.productStatus === 'HOLD'
                      ? 'selected': '' %> >HOLD</option>
                      <option value="SALE" <%= value.productStatus === 'SALE'
                      ? 'selected': '' %>>SALE</option>
                      <option value="SOLD" <%= value.productStatus === 'SOLD'
                      ? 'selected': '' %>>SOLD</option>
                      <option value="DELETE" <%= value.productStatus === 'DELETE'
                      ? 'selected': '' %>>DELETE</option>
                    </select>
                  </td>
                </tbody>
             <% })%>
            <!--  LOOP PRODUCTS: END  -->
          </table>
          <div
            class="long-input"
            style="align-items: flex-end; margin-bottom: 25px"
          >
            <!-- <button class="btn btn-primary" id="process-btn">
              New Product
            </button> -->
          </div>
        </div>
        <form
        onsubmit="return validateForm()"
          action="/admin/product/create"
          method="POST"
          class="prod-container"
          enctype="multipart/form-data"
        >
          <div class="long-input" style="display: flex; align-items: center">
            <span class="new-snkrs-txt">New snkrs</span>
          </div>
          <div class="login-input-frame">
            <div class="long-input">
              <label style="font-weight: bold;">Product Name *</label>
              <input
                type="text"
                placeholder="Name"
                name="productName"
                class="product-name"
              />
            </div>
            <input
              name="productStatus"
              value="HOLD"
              class="product-status"
              hidden
            />
          </div>
          <div class="half-input-frame">
            <div class="half-input">
              <label style="font-weight: bold;">Product Price *</label>
              <input
                type="number"
                placeholder="Price"
                name="productPrice"
                class="product-price"
              />
            </div>
            <div class="half-input">
              <label style="font-weight: bold;">Product Stock *</label>
              <input
                type="number"
                placeholder="Counts"
                name="productLeftCount"
                class="product-left-count"
              />
            </div>
          </div>
          <div class="half-input-frame">
            <div class="half-input">
              <label style="font-weight: bold;">Brand *</label>
              <select class="product-collection" name="productCollection">
                <option value="NIKE" selected>Nike</option>
                <option value="ADIDAS">Adidas</option>
                <option value="PUMA">Puma</option>
                <option value="NEW BALANCE">New Balance</option>
                <option value="MIX">Mix</option>
              </select>
            </div>

            <div class="half-input" id="product-collection">
              <label style="font-weight: bold;">Product Size *</label>
              <select class="form-control" name="productSize">
                <option value="40">Small (40)</option>
                <option value="41">Medium (41)</option>
                <option value="42">Large (42)</option>
                <option value="43">X-Large (43)</option>
              </select>
            </div>
          </div>
          <div class="long-input">
            <label style="font-weight: bold;">Product Description *</label>
            <textarea name="productDesc" class="product-desc"></textarea>
          </div>

          <div class="img-frame">
            <label style="font-weight: bold;">Product Images *</label>
            <div class="media-frame">
                <div class="upload-img-box">
                    <img src="" class="1" id="image-section-1" />
                    <input
                        type="file"
                        id="file"
                        name="productImages1"  
                        class="image-one"
                        required
                        onchange="previewFileHandler(this, 1)" 
                    />
                </div>
                <div class="upload-img-box">
                    <img src="" class="2" id="image-section-2" />
                    <input
                        type="file"
                        id="file"
                        name="productImages2"  
                        class="image-two"
                        onchange="previewFileHandler(this, 2)" 
                    />
                </div>
                <div class="upload-img-box">
                    <img src="" class="3" id="image-section-3" />
                    <input
                        type="file"
                        id="file"
                        name="productImages3"  
                        class="image-three"
                        onchange="previewFileHandler(this, 3)" 
                    />
                </div>
               
                <input name="adminId" class="admin-id" hidden />
            </div>
        </div>
        

          <div class="operation-buttons">
            <button class="btn btn-danger" id="cancel-btn">Cancel</button>
            <button type="submit" class="btn btn-primary" id="create-btn">
              Create
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
