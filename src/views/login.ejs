<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <div class="login-container">
    <form action="/admin/login" method="POST">
      <div class="login-frame">
        <div class="login-top">
          <span>Login to Snkrs!</span>
          <div>Back <a href="/admin">Home</a></div>
          <p>
            Not registered yet?
            <a href="/admin/signup">Signup</a>
          </p>
        </div>

        <div class="login-input-frame">
          <div class="login-input-container">
            <label for="memberNick">Admin #</label>
            <input
              type="text"
              name="memberNick"
              id="memberNick"
              class="member-nick"
              placeholder="Insert username..."
              required
            />
          </div>
        </div>

        <div class="login-input-frame">
          <div class="login-input-container">
            <label for="memberPassword">Password #</label>
            <input
              type="password"
              name="memberPassword"
              id="memberPassword"
              class="member-password"
              placeholder="Insert your password..."
              required
            />
          </div>
        </div>

        <div class="login-input-frame">
          <button class="login-btn" name="login" type="submit">
            Login
          </button>
        </div>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/login.js"></script>
</body>

<%- include('includes/footer') %>
