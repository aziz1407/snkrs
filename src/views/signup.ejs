<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <div class="signup-container">
    <form onsubmit="return validateSignupForm()" action="/admin/signup" method="POST" enctype="multipart/form-data">
      <div class="signup-frame" style="width: 650px">
        <div class="signup-top">
          <span style="font-family: arial; font-size: 25px; margin-left: 30%; font-style: italic; font-weight: bold;">Signup to Snkrs!</span>
          <div style="font-family: arial; font-size: 17px; font-style: italic;">Back <a href="/admin" style="color: #6440fb">Home</a></div>
          <p style="font-family: arial; font-size: 17px; font-style: italic;">
            Already a member?
            <a href="/admin/login" style="color: #6440fb">Login</a>
          </p>
        </div>

        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label style="font-family: arial; font-size: 17px; font-style: italic;">Admin #</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Insert username..."
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label style="font-family: arial; font-size: 17px; font-style: italic;">Phone #</label>
            <input
              type="text"
              name="memberPhone"
              class="member-phone"
              placeholder="Insert your number..."
              value=""
            />
          </div>
        </div>
        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label style="font-family: arial; font-size: 17px; font-style: italic;">Password #</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Insert your password"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label style="font-family: arial; font-size: 17px; font-style: italic;">Repeat password #</label>
            <input
              type="password"
              name="confirmPassword"
              class="confirm-password"
              placeholder="Reassure password..."
              value=""
            />
          </div>
        </div>

        <div class="signup-input-frame">
          <div class="media-frame">
            <img class="upload-img-frame" src="/img/default.jpeg" />
            <div class="upload-container">
              <span class="media-text" style="font-family: arial; font-size: 17px; margin-top: 10px; font-style: italic;">Product image</span>
              <div
                class="file-box bs3-primary preview-image"
                style="margin-top: 25px; display: flex"
              >
                <input
                  class="upload-name"
                  value="Choose image"
                  disabled="disabled"
                />
                <label for="input-file" class="file-input-label" style="background-color:  #007bff;"
                  >Upload!</label
                >
                <input
                  type="file"
                  id="input-file"
                  class="upload-hidden form-control-file member-image"
                  name="memberImage"
                />
              </div>
              <p class="thumbnail-desc" style="font-family: arial; font-size: 17px; font-style: italic;">
                Please upload restaurant image.<br />
                Attention only: .jpg, .jpeg, or .png. <br />
                formats allowed!
              </p>
            </div>
          </div>
        </div>

        <input name="memberType" value="RESTAURANT" hidden />

        <button class="signup-btn btn" name="signup" type="submit">
          Signup
        </button>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
