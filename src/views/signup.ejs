<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <div class="signup-container">
    <form onsubmit="return validateSignupForm()" action="/admin/signup" method="POST" enctype="multipart/form-data">
      <div class="signup-frame">
        <div class="signup-header">
          <h2>Signup to Snkrs!</h2>
          <p><a href="/admin/login" class="login-link">Login</a></p>
          <a href="/admin" class="back-home">Back Home</a>
        </div>

        <div class="input-section">
          <label for="memberNick">Admin *</label>
          <input type="text" name="memberNick" id="memberNick" placeholder="Insert username..." />

          <label for="memberPhone">Phone *</label>
          <input type="text" name="memberPhone" id="memberPhone" placeholder="Insert your number..." />

          <label for="memberPassword">Password *</label>
          <input type="password" name="memberPassword" id="memberPassword" placeholder="Insert your password..." />

          <label for="confirmPassword">Repeat password *</label>
          <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Reassure password..." />
        </div>

        <div class="upload-section">
          <div class="upload-preview">
            <img src="/img/idea11.avif" alt="Profile Image" />
          </div>
          <div class="file-input">
            <input type="file" id="input-file" name="memberImage" />
          </div>
          <p style="font-size: 17px; font-weight: bold;">Only .jpg, .jpeg, .png formats allowed</p>
        </div>

        <input name="memberType" value="ADMIN" hidden />
        <button class="signup-btn" type="submit">Create Account</button>
      </div>
    </form>
  </div>

  <script src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
